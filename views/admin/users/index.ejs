<div class="page-header">
  <h1>Users Management</h1>
  <a href="/admin/users/create" class="primary-btn">
    <i class="fas fa-plus"></i> Add New User
  </a>
</div>

<!-- Success/Error Messages -->
<% if (locals.success) { %>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    <%= locals.success %>
    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
      <span aria-hidden="true">&times;</span>
    </button>
  </div>
<% } %>

<% if (locals.error) { %>
  <div class="alert alert-danger alert-dismissible fade show" role="alert">
    <%= locals.error %>
    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
      <span aria-hidden="true">&times;</span>
    </button>
  </div>
<% } %>

<!-- Column Filters Section -->
<div class="column-filters-section">
  <div class="row" style="display: flex; gap: 10px; flex-wrap: wrap; padding: 10px 0px;">
    <!-- Name Filter -->
    <div class="col-md-3 col-sm-6 col-12 mb-3">
      <div class="filter-column">
        <label for="nameFilter">Name:</label>
        <input type="text" id="nameFilter" placeholder="Filter by name..." class="form-control" />
      </div>
    </div>

    <!-- Username Filter -->
    <div class="col-md-3 col-sm-6 col-12 mb-3">
      <div class="filter-column">
        <label for="usernameFilter">Username:</label>
        <input type="text" id="usernameFilter" placeholder="Filter by username..." class="form-control" />
      </div>
    </div>

    <!-- Email Filter -->
    <div class="col-md-3 col-sm-6 col-12 mb-3">
      <div class="filter-column">
        <label for="emailFilter">Email:</label>
        <input type="text" id="emailFilter" placeholder="Filter by email..." class="form-control" />
      </div>
    </div>

    <!-- Role Filter -->
    <div class="col-md-3 col-sm-6 col-12 mb-3">
      <div class="filter-column">
        <label for="roleFilter">Role:</label>
        <select id="roleFilter" class="form-control">
          <option value="">All Roles</option>
          <option value="1">Admin</option>
          <option value="2">User</option>
        </select>
      </div>
    </div>

</div>

    <!-- Control Buttons -->
    <div class="col-md-6 col-sm-12 col-12 mb-3 d-flex align-items-end">
      <div class="filter-controls">
        <button id="clearAllFilters" class="btn btn-secondary">
          Clear Filters
        </button>
        <button id="applyFilters" class="btn btn-primary">
          Apply Filters
        </button>
      </div>
    </div>
  
</div>

<!-- Users Table -->
<table id="usersTable" class="content-table display" style="width:100%">
  <thead>
  <tr>
      <th>Index</th>
      <th>Name</th>
      <th>Username</th>
      <th>Email</th>
      <th>Role</th>
      <!-- <th>Created</th> -->
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <!-- Data will be loaded via AJAX -->
  </tbody>
</table>

<%- contentFor('styles') %>
<style>
.user-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: linear-gradient(45deg, #007bff, #28a745);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-weight: bold;
  font-size: 14px;
  margin-right: 10px;
}

.dataTable-image-text {
  display: flex;
  align-items: center;
}

.user-name-text {
  flex: 1;
}
</style>

<%- contentFor('scripts') %>
<script>
$(document).ready(function() {
    var table = $('#usersTable').DataTable({
        processing: true,
        serverSide: true,
        ajax: {
            url: '/admin/api/users-datatable',
            type: 'GET',
            data: function(d) {
                d.nameFilter = $('#nameFilter').val() || '';
                d.usernameFilter = $('#usernameFilter').val() || '';
                d.emailFilter = $('#emailFilter').val() || '';
                d.roleFilter = $('#roleFilter').val() || '';
                d.dateFrom = $('#dateFromFilter').val() || '';
                d.dateTo = $('#dateToFilter').val() || '';
                
                console.log('Sending user filters:', {
                    nameFilter: d.nameFilter,
                    usernameFilter: d.usernameFilter,
                    emailFilter: d.emailFilter,
                    roleFilter: d.roleFilter,
                    dateFrom: d.dateFrom,
                    dateTo: d.dateTo
                });
            },
            error: function(xhr, error, thrown) {
                console.error('Users DataTable AJAX error:', error, thrown);
                console.error('Response:', xhr.responseText);
            }
        },
        columns: [
            // Index column - uses DataTables built-in row index
            {
                data: null,
                name: 'index',
                orderable: false,
                searchable: false,
                width: '6%',
                render: function(data, type, row, meta) {
                    return meta.row + meta.settings._iDisplayStart + 1;
                }
            },
            { data: 0, name: 'name', orderable: true, searchable: true, width: '20%' },
            { data: 1, name: 'username', orderable: true, searchable: true, width: '15%' },
            { data: 2, name: 'email', orderable: true, searchable: true, width: '20%' },
            { data: 3, name: 'is_admin', orderable: true, searchable: false, width: '10%' },
            { data: 4, name: 'actions', orderable: false, searchable: false, width: '10%' }
        ],
        order: [[1, 'asc']], // Sort by "Name" column by default
        pageLength: 10,
        lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
        language: {
            processing: "Loading users...",
            emptyTable: "No users found",
            zeroRecords: "No matching users found"
        }
    });

    // Filter events with debounce for text inputs
    $('#nameFilter, #usernameFilter, #emailFilter').on('keyup input', function() {
        clearTimeout(window.filterTimeout);
        window.filterTimeout = setTimeout(() => table.draw(), 500);
    });

    $('#roleFilter, #dateFromFilter, #dateToFilter').on('change', function() {
        table.draw();
    });

    $('#applyFilters').on('click', function() {
        table.draw();
    });

    $('#clearAllFilters').on('click', function() {
        $('#nameFilter, #usernameFilter, #emailFilter, #dateFromFilter, #dateToFilter').val('');
        $('#roleFilter').val('');
        table.draw();
    });

    // Toggle role functionality
    $(document).on('click', '.toggle-role', function(e) {
        e.preventDefault();
        const userId = $(this).data('id');
        
        if (confirm('Are you sure you want to change this user\'s role?')) {
            $.post(`/admin/users/toggle-role/${userId}`, function(response) {
                if (response.success) {
                    table.ajax.reload(null, false);
                } else {
                    alert('Error: ' + response.message);
                }
            }).fail(function() {
                alert('Error occurred while updating user role');
            });
        }
    });

    // Auto-hide alerts after 5 seconds
    setTimeout(function() {
        $('.alert').fadeOut('slow');
    }, 5000);
});
</script>

