<div class="page-header">
  <h1>Manage Users</h1>
  <a href="/admin/users/create" class="primary-btn">
    <i class="fas fa-plus"></i> Add New User
  </a>
</div>

<!-- Individual Column Filters -->
<div
  class="column-filters-section">
  <!-- <h5>Column Filters</h5> -->

  <!-- First Row: Name, Username, Email -->
  <div class="row" style="display: flex; gap: 10px; flex-wrap: wrap; padding: 10px 0px;" >
    <!-- Name Filter -->
    <div class="col-md-4 col-sm-6 col-12 mb-3">
      <div class="filter-column">
        <label for="nameFilter" style="font-weight: 600; display: block; margin-bottom: 5px">Name:</label>
        <input type="text" id="nameFilter" placeholder="Filter by name..." class="form-control" style="padding: 8px 12px; border: 1px solid #ddd; border-radius: 4px"/>
      </div>
    </div>

    <!-- Username Filter -->
    <div class="col-md-4 col-sm-6 col-12 mb-3">
      <div class="filter-column">
        <label class="filer-label" for="usernameFilter"
          style="font-weight: 600; display: block; margin-bottom: 5px"
          >Username:</label
        >
        <input
          type="text"
          id="usernameFilter"
          placeholder="Filter by username..."
          class="form-control"
          style="padding: 8px 12px; border: 1px solid #ddd; border-radius: 4px"
        />
      </div>
    </div>

    <!-- Email Filter -->
    <div class="col-md-4 col-sm-6 col-12 mb-3">
      <div class="filter-column">
        <label
          for="emailFilter"
          style="font-weight: 600; display: block; margin-bottom: 5px"
          >Email:</label
        >
        <input
          type="text"
          id="emailFilter"
          placeholder="Filter by email..."
          class="form-control"
          style="padding: 8px 12px; border: 1px solid #ddd; border-radius: 4px"
        />
      </div>
    </div>

    <!-- Role Filter -->
    <div class="col-md-4 col-sm-6 col-12 mb-3">
      <div class="filter-column">
        <label
          for="roleFilter"
          style="font-weight: 600; display: block; margin-bottom: 5px"
          >Role:</label
        >
        <select
          id="roleFilter"
          class=" col-md-4 col-sm-6 col-12 mb-3"
          style="padding: 8px 12px; border: 1px solid #ddd; border-radius: 4px"
        >
          <option value="">All Roles</option>
          <option value="1">Admin</option>
          <option value="0">User</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Control Buttons -->
  <div class="col-md-8 col-sm-6 col-12 mb-3 d-flex align-items-end">
    <div
      class="filter-controls" style="display: flex; gap: 10px; flex-wrap: wrap">
      <button id="clearAllFilters" class="btn btn-secondary" style="padding: 8px 16px">
        Clear All Filters
      </button>
      <button id="applyFilters" class="btn btn-primary" style="padding: 8px 16px">
         Apply Filters
      </button>
    </div>
  </div>
</div>

<table id="usersTable" class="content-table display" style="width: 100%">
  <thead>
    <tr>
      <th>Name</th>
      <th>Username</th>
      <th>Email</th>
      <th>Role</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <!-- Server-side data will populate this -->
  </tbody>
</table>

<%- contentFor('scripts') %>
<script>
  console.log("Loading DataTable script with individual column filters...");
  $(document).ready(function () {
    console.log("DOM ready, initializing DataTable...");

    // Initialize DataTable
    var table = $("#usersTable").DataTable({
      processing: true,
      serverSide: true,
      ajax: {
        url: "/admin/api/users-datatable",
        type: "GET",
        data: function (d) {
          // Add individual column filter parameters
          d.nameFilter = $("#nameFilter").val();
          d.usernameFilter = $("#usernameFilter").val();
          d.emailFilter = $("#emailFilter").val();
          d.roleFilter = $("#roleFilter").val();
        },
        error: function (xhr, error, thrown) {
          console.error("DataTable Ajax error:", error, thrown);
          console.error("Response:", xhr.responseText);
          alert("Error loading data: " + error);
        },
        beforeSend: function () {
          console.log("Making AJAX request to:", "/admin/api/users-datatable");
        },
      },
      columns: [
        { data: 0, name: "name" },
        { data: 1, name: "username" },
        { data: 2, name: "email" },
        { data: 3, name: "role" },
        { data: 4, name: "actions", orderable: false, searchable: false },
      ],
      pageLength: 25,
      lengthMenu: [
        [10, 25, 50, 100],
        [10, 25, 50, 100],
      ],
      order: [[0, "asc"]],
      language: {
        processing: "Loading users...",
        emptyTable: "No users found",
        info: "Showing _START_ to _END_ of _TOTAL_ users",
        infoEmpty: "Showing 0 to 0 of 0 users",
        infoFiltered: "(filtered from _MAX_ total users)",
      },
      dom: '<"top"lf>rt<"bottom"ip><"clear">',
    });

    console.log("DataTable initialized");

    // Individual column filter events
    $("#nameFilter").on("keyup", function () {
      var value = this.value;
      console.log("Name filter changed to:", value);
      table.draw();
    });

    $("#usernameFilter").on("keyup", function () {
      var value = this.value;
      console.log("Username filter changed to:", value);
      table.draw();
    });

    $("#emailFilter").on("keyup", function () {
      var value = this.value;
      console.log("Email filter changed to:", value);
      table.draw();
    });

    $("#roleFilter").on("change", function () {
      var value = this.value;
      console.log("Role filter changed to:", value);
      table.draw();
    });

    // Apply filters button (optional - filters work automatically)
    $("#applyFilters").on("click", function () {
      console.log("Applying all filters manually");
      table.draw();
    });

    // Clear all filters
    $("#clearAllFilters").on("click", function () {
      console.log("Clearing all column filters");
      $("#nameFilter").val("");
      $("#usernameFilter").val("");
      $("#emailFilter").val("");
      $("#roleFilter").val("");
      table.search("").draw();
    });

    // Debug: Log when table draws
    table.on("draw", function () {
      console.log("Table redrawn with filters");
    });

    // Add debouncing for better performance
    function debounce(func, wait) {
      let timeout;
      return function executedFunction(...args) {
        const later = () => {
          clearTimeout(timeout);
          func(...args);
        };
        clearTimeout(timeout);
        timeout = setTimeout(later, wait);
      };
    }

    // Apply debouncing to text inputs (300ms delay)
    $("#nameFilter, #usernameFilter, #emailFilter").on(
      "keyup",
      debounce(function () {
        table.draw();
      }, 300)
    );
  });
</script>
