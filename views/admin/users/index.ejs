<div class="page-header">
    <h1>Manage Users</h1>
    <a href="/admin/users/create" class="create-btn">
        <i class="fas fa-plus"></i> Add New User
    </a>
</div>

<table class="content-table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Username</th>
            <th>Email</th>
            <th>Role</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        <% users.forEach(user => { %>
            <tr>
                <td><%= user.name %></td>
                <td><%= user.username %></td>
                <td><%= user.email %></td>
                <td><%= user.is_admin === 1 ? 'Admin' : 'User' %></td>
                <td class="actions">
                    <a href="/admin/users/view/<%= user._id %>" class="icon-btn" title="View">
                        <i class="fas fa-eye blue-icon"></i>
                    </a>
                    <a href="/admin/users/edit/<%= user._id %>" class="icon-btn" title="Edit">
                        <i class="fas fa-edit green-icon"></i>
                    </a>
                    <form action="/admin/users/delete/<%= user._id %>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this user?');">
                        <button type="submit" class="icon-btn" title="Delete">
                            <i class="fas fa-trash-alt red-icon"></i>
                        </button>
                    </form>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">